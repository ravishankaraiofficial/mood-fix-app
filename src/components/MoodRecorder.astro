---
// src/components/MoodRecorder.astro
import CrisisHandoff from './CrisisHandoff.astro';
import ErgonomicReset from './ErgonomicReset.astro';
import VoiceFluidCanvas from './VoiceFluidCanvas.astro';
import OpticalVitals from './OpticalVitals.astro';
import ImmersiveRoom from './ImmersiveRoom.astro';
---

<mood-recorder class="w-full flex flex-col items-center pt-2 relative">
  <!-- Top Bar with BT Sync -->
  <div class="w-full flex justify-between items-center mb-6 px-4">
    <!-- Sympathy Sync WebRTC UI -->
    <div id="sympathy-sync-ui" class="flex gap-2 items-center">
      <input type="text" id="sync-room-code" placeholder="Code" class="w-16 px-2 py-1.5 border border-indigo-200 rounded text-center text-xs focus:outline-none focus:ring-1 focus:ring-indigo-400 bg-white">
      <button id="sync-connect-btn" data-i18n-key="coregulate" class="px-3 py-1.5 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-full text-xs font-medium transition-colors border border-indigo-100 shadow-sm">
        Co-Regulate
      </button>
      <span id="sync-status-text" class="text-[10px] text-indigo-800 hidden md:inline"></span>
    </div>

    <button id="bt-sync-btn" class="flex items-center gap-1 px-3 py-1.5 bg-rose-50 text-rose-700 hover:bg-rose-100 rounded-full text-xs font-medium transition-colors border border-rose-100 shadow-sm ml-auto mr-2">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
      <span id="bt-status-text" data-i18n-key="connect_vitals">Connect Vitals</span>
    </button>
    
    <button id="audio-toggle-btn" class="flex items-center gap-1 px-3 py-1.5 bg-orange-100 text-orange-800 hover:bg-orange-200 rounded-full text-xs font-medium transition-colors border border-orange-200 shadow-sm">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
      </svg>
      <span id="audio-status-text" data-i18n-key="soundscape_off">Soundscape: Off</span>
    </button>
  </div>

  <!-- Language Bar -->
  <nav id="lang-bar" class="w-full flex flex-wrap justify-center gap-x-3 gap-y-2 mb-10 text-sm text-orange-900/60 transition-all" aria-label="Language selection">
    <button type="button" class="lang-btn" data-lang="en">English</button>
    <button type="button" class="lang-btn" data-lang="hi">हिन्दी</button>
    <button type="button" class="lang-btn" data-lang="bn">বাংলা</button>
    <button type="button" class="lang-btn" data-lang="te">తెలుగు</button>
    <button type="button" class="lang-btn" data-lang="mr">मराठी</button>
    <button type="button" class="lang-btn" data-lang="ta">தமிழ்</button>
    <button type="button" class="lang-btn" data-lang="gu">ગુજરાતી</button>
    <button type="button" class="lang-btn" data-lang="ur">اردو</button>
    <button type="button" class="lang-btn" data-lang="kn">ಕನ್ನಡ</button>
    <button type="button" class="lang-btn" data-lang="or">ଓଡ଼ିଆ</button>
    <button type="button" class="lang-btn" data-lang="ml">മലയാളം</button>
    <button type="button" class="lang-btn" data-lang="pa">ਪੰਜਾਬੀ</button>
    <button type="button" class="lang-btn" data-lang="as">অসমীয়া</button>
  </nav>

  <VoiceFluidCanvas />
  <OpticalVitals />

  <!-- Breathing Circle -->
  <div class="relative w-48 h-48 mx-auto mb-8 flex justify-center items-center">
    <!-- Partner Circle -->
    <div id="partner-circle" class="absolute w-40 h-40 bg-indigo-300 rounded-full opacity-0 pointer-events-none transition-all duration-100 mix-blend-multiply will-change-transform"></div>

    <div id="breathing-circle" class="absolute w-40 h-40 bg-orange-300 rounded-full shadow-lg opacity-80 mix-blend-multiply"></div>
    <div id="breathing-text" class="relative z-10 text-orange-900 font-bold text-xl tracking-wide opacity-0 transition-opacity duration-500">
      Breathe
    </div>
  </div>

  <!-- Record View -->
  <div id="record-view" class="w-full flex flex-col items-center">
    <h1 id="ui-heading" data-i18n-key="heading" class="text-3xl font-semibold tracking-tight mb-2 text-orange-900 transition-all duration-300">
      Tell me how you’re feeling
    </h1>
    <p id="ui-subheading" data-i18n-key="subheading" class="text-base text-orange-800/80 mb-12 transition-all duration-300">
      Speak for up to 30 seconds. I’ll listen and respond.
    </p>

    <!-- Status Region -->
    <div class="h-12 mb-8 flex items-center justify-center text-center">
      <p id="status-text" data-i18n-key="status_start" class="text-lg font-medium text-orange-900 transition-all duration-300" aria-live="polite">
        Tap the microphone to start.
      </p>
    </div>

    <!-- Record Button -->
    <button 
      id="record-btn" 
      aria-label="Record how you're feeling"
      class="relative flex items-center justify-center w-24 h-24 rounded-full bg-orange-500 hover:bg-orange-600 text-white shadow-soft"
    >
      <svg id="mic-icon" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
      </svg>
      <svg id="stop-icon" xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 absolute opacity-0" fill="currentColor" viewBox="0 0 24 24">
        <rect x="6" y="6" width="12" height="12" rx="2" />
      </svg>
      <div id="pulse-ring" class="absolute inset-0 rounded-full border-2 border-orange-500 opacity-0 pointer-events-none"></div>
    </button>
    
    <p id="error-message" class="mt-6 text-sm text-red-600 text-center hidden font-medium px-4 py-2 bg-red-50 rounded-md transition-all duration-300"></p>
  </div>

  <!-- Response View -->
  <div id="response-view" class="w-full hidden flex-col items-center animate-fade-in">
    <h1 id="response-heading" class="text-3xl font-semibold tracking-tight mb-8 text-orange-900 transition-all duration-300" aria-live="polite">
      I hear you’re feeling: …
    </h1>

    <div id="response-content-area" class="w-full mb-8 text-left transition-all duration-300" aria-live="polite"></div>

    <div id="breathing-circle-container" class="hidden mb-8 w-full flex items-center justify-center h-32">
      <div class="w-24 h-24 rounded-full bg-orange-400/30 breathing-circle"></div>
    </div>

    <CrisisHandoff />

    <button id="start-over-btn" class="mt-6 px-6 py-3 bg-white border border-orange-200 rounded-full text-orange-900 font-medium shadow-sm hover:bg-orange-50 active:scale-95 transition-transform">
      Start over
    </button>
  </div>
  
  <ErgonomicReset />
  <ImmersiveRoom />
  
  <div id="lang-toast" class="fixed bottom-24 left-1/2 -translate-x-1/2 bg-orange-900/95 backdrop-blur-sm text-orange-50 px-6 py-3 rounded-full text-sm font-medium shadow-xl pointer-events-none transition-all duration-300 opacity-0 translate-y-4 z-50 flex items-center gap-2">
    <span id="lang-toast-text"></span>
  </div>
</mood-recorder>

<style>
  :root {
    --breathe-duration: 10s;
  }
  button { touch-action: manipulation; }
  .lang-btn { transition: font-weight 200ms, opacity 200ms; }
  .lang-btn.active { font-weight: 700; color: #7c2d12; text-decoration: underline; text-decoration-color: #ea580c; text-underline-offset: 4px; }
  
  #lang-toast.show { opacity: 1; transform: translate(-50%, 0); }
  
  #status-text { font-variant-numeric: tabular-nums; }

  @keyframes pulse-ring {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  .is-recording #pulse-ring { animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite; }
  .is-recording #mic-icon { transform: scale(0.5); opacity: 0; }
  .is-recording #stop-icon { opacity: 1; }
  .is-recording #record-btn { transform: scale(0.95); }

  @keyframes breathe {
    0% { transform: scale(1); }
    40% { transform: scale(1.4); }
    50% { transform: scale(1.4); }
    90% { transform: scale(1); }
    100% { transform: scale(1); }
  }
  .breathing-circle {
    animation: breathe var(--breathe-duration) linear infinite;
    transform-origin: center;
  }

  .calming-text { font-size: 1.125rem; line-height: 1.6; color: #7c2d12; }
  .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    .is-recording #pulse-ring, .breathing-circle { animation: none !important; display: none !important; }
    #lang-toast { transition: opacity 300ms !important; transform: translate(-50%, 0) !important; }
    #lang-toast.show { opacity: 1 !important; }
  }
</style>

<script>
  // @ts-nocheck
  import { saveMoodLog } from '../lib/db';
  import { toggleSoundscape, updateSoundscape } from '../lib/audioEngine';
  import { SympathySyncClient } from '../lib/webrtc';
  import { startHapticPacing, stopHapticPacing } from '../lib/haptics';
  import { getEnvironmentalContext } from '../lib/environment';
  import { translateUI, translations } from '../lib/i18n';
  
  const i18n = {
    en: { langName: "English", heading: "Tell me how you’re feeling", status_start: "Tap the microphone to start.", status_recording: "Recording… {time}", status_processing: "Processing…", status_error: "Something went wrong.", response_prefix: "I hear you’re feeling:" },
    // Simplified for script length - dynamic fallback in prod
    hi: { langName: "हिन्दी", heading: "मुझे बताएं कि आप कैसा महसूस कर रहे हैं", status_start: "टैप करें।", status_recording: "रिकॉर्ड हो रहा है… {time}", status_processing: "प्रक्रिया हो रही है…", status_error: "त्रुटि।", response_prefix: "आप महसूस कर रहे हैं:" }
  };

  class MoodRecorder extends HTMLElement {
    constructor() {
      super();
      this.btn = this.querySelector('#record-btn');
      this.startOverBtn = this.querySelector('#start-over-btn');
      this.btSyncBtn = this.querySelector('#bt-sync-btn');
      this.audioToggleBtn = this.querySelector('#audio-toggle-btn');
      this.syncBtn = this.querySelector('#sync-connect-btn');
      this.syncCode = this.querySelector('#sync-room-code');
      this.syncStatus = this.querySelector('#sync-status-text');
      this.partnerCircle = this.querySelector('#partner-circle');
      this.breathingCircle = this.querySelector('#breathing-circle');

      this.mediaRecorder = null;
      this.isRecording = false;
      this.currentLang = localStorage.getItem('moodLang') || 'en';
      this.envContext = null;
      this.ws = null;
      
      // Fetch stateless environment on init
      getEnvironmentalContext().then(ctx => {
        this.envContext = ctx;
      });

      this.init();
      
      // Initialize text to localized state if needed
      if (this.currentLang && this.currentLang !== 'en') {
        setTimeout(() => translateUI(this.currentLang), 0);
      }
    }

    init() {
      this.setupLanguageBar();
      this.btn.addEventListener('click', () => this.toggleRecording());
      this.startOverBtn.addEventListener('click', () => this.resetUI());
      this.btSyncBtn.addEventListener('click', () => this.connectWearable());
      this.audioToggleBtn.addEventListener('click', () => this.toggleAudio());
      this.syncBtn.addEventListener('click', () => this.connectSympathySync());

      // Broadcaster for breathing animation scale
      setInterval(() => {
        if (this.syncClient && this.breathingCircle) {
          const scale = window.getComputedStyle(this.breathingCircle).transform;
          if (scale !== 'none') {
            const values = scale.split('(')[1].split(')')[0].split(',');
            const scaleVal = Math.sqrt(values[0]*values[0] + values[1]*values[1]);
            this.syncClient.sendData({ scale: scaleVal });
          }
        }
      }, 100);
      
      window.resetMoodRecorderUI = () => this.resetUI();
    }

    async connectSympathySync() {
      const code = this.syncCode.value.trim();
      if (!code || code.length < 4) return;
      
      if (this.syncClient) {
        this.syncClient.disconnect();
      }

      this.syncClient = new SympathySyncClient(code, (data) => {
        if (data.scale && this.partnerCircle) {
          this.partnerCircle.style.transform = `scale(${data.scale})`;
          this.partnerCircle.style.opacity = '0.6';
        }
      }, (status) => {
        this.syncStatus.textContent = status;
        
        // Expose haptic pulse button if connected
        if (status === 'Co-Regulation Active' && this.syncClient) {
           const squeezeBtn = document.createElement('button');
           squeezeBtn.className = 'w-full py-2 mt-2 bg-orange-100 text-orange-800 text-xs rounded-xl font-bold border border-orange-200 active:bg-orange-300 transition-colors';
           squeezeBtn.textContent = 'Send Haptic Squeeze';
           squeezeBtn.onclick = () => {
             this.syncClient.sendHapticPulse();
           };
           // Avoid duplicates
           const existing = document.getElementById('haptic-squeeze-btn');
           if (!existing) {
             squeezeBtn.id = 'haptic-squeeze-btn';
             this.syncStatus.parentNode.appendChild(squeezeBtn);
           }
        } else {
           const existing = document.getElementById('haptic-squeeze-btn');
           if (existing) existing.remove();
        }
      });
      
      await this.syncClient.connect();
    }

    toggleAudio() {
      this.soundscapePlaying = !this.soundscapePlaying;
      toggleSoundscape(this.soundscapePlaying);
      const txt = this.querySelector('#audio-status-text');
      const langDict = translations[this.currentLang] || translations['en'];
      
      if (this.soundscapePlaying) {
        txt.textContent = langDict.soundscape_on || 'Soundscape: On';
        this.audioToggleBtn.classList.replace('bg-orange-100', 'bg-green-100');
        this.audioToggleBtn.classList.replace('text-orange-800', 'text-green-800');
      } else {
        txt.textContent = langDict.soundscape_off || 'Soundscape: Off';
        this.audioToggleBtn.classList.replace('bg-green-100', 'bg-orange-100');
        this.audioToggleBtn.classList.replace('text-green-800', 'text-orange-800');
      }
    }

    setupLanguageBar() {
      const savedLang = localStorage.getItem('moodReliefLang');
      if (savedLang) this.currentLang = savedLang;
      this.querySelectorAll('.lang-btn').forEach(btn => {
        if(btn.dataset.lang === this.currentLang) btn.classList.add('active');
        btn.addEventListener('click', () => this.setLanguage(btn.dataset.lang));
      });
    }

    setLanguage(langCode) {
      this.currentLang = langCode;
      localStorage.setItem('moodReliefLang', langCode);
      document.documentElement.dir = (langCode === 'ur') ? 'rtl' : 'ltr';
      this.querySelectorAll('.lang-btn').forEach(b => b.classList.toggle('active', b.dataset.lang === langCode));
      
      translateUI(langCode);
      
      // Dispatch event for other components to listen
      window.dispatchEvent(new CustomEvent('language-changed', { detail: langCode }));
      
      // Update Crisis UI globally if available
      if (window.updateCrisisUI) window.updateCrisisUI(langCode);
    }

    async connectWearable() {
      try {
        const device = await navigator.bluetooth.requestDevice({ filters: [{ services: ['heart_rate'] }] });
        const server = await device.gatt.connect();
        const service = await server.getPrimaryService('heart_rate');
        const characteristic = await service.getCharacteristic('heart_rate_measurement');
        
        characteristic.startNotifications();
        document.getElementById('bt-status-text').textContent = 'Vitals Linked';
        this.btSyncBtn.classList.replace('bg-rose-50', 'bg-green-50');
        this.btSyncBtn.classList.replace('text-rose-700', 'text-green-700');

        characteristic.addEventListener('characteristicvaluechanged', (event) => {
          const value = event.target.value;
          const heartRate = value.getUint8(1);
          // Target breathe duration formula: Map 60-120 HR to 8-16s cycles
          const targetBreatheDuration = Math.max(8, (heartRate / 60) * 8); 
          document.documentElement.style.setProperty('--breathe-duration', `${targetBreatheDuration}s`);
          
          // Interpolate the somatic soundscape based on incoming HR
          updateSoundscape(heartRate);
        });
      } catch (error) {
        console.warn("Bluetooth permission denied or unavailable", error);
        document.getElementById('bt-status-text').textContent = 'Sync Failed';
      }
    }

    async toggleRecording() {
      if (this.isRecording) this.stopRecording();
      else await this.startRecording();
    }

    async startRecording() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        
        // Use wss for secure socket connection
        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        this.ws = new WebSocket(`${protocol}//${window.location.host}/api/stream`);
        
        this.ws.onopen = () => {
          this.ws.send(JSON.stringify({ 
             type: 'start', 
             language: this.currentLang,
             environment: this.envContext 
          }));
          
          this.mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });
          this.mediaRecorder.ondataavailable = (e) => {
            if (e.data.size > 0 && this.ws.readyState === WebSocket.OPEN) {
              this.ws.send(e.data); // Stream raw binary
            }
          };
          this.mediaRecorder.start(500); // 500ms chunks
          this.isRecording = true;
          this.querySelector('#record-view').classList.add('is-recording');
          if (window.startVoiceFluid) window.startVoiceFluid(stream);
          if (window.startOpticalVitals) window.startOpticalVitals();
        };

        this.ws.onmessage = async (e) => {
          try {
            const data = JSON.parse(e.data);
            this.renderResponse(data);
            await saveMoodLog(data); // Save Zero-Knowledge Encrypted
          } catch(err) {
            console.error("WS Parse Error", err);
          }
        };
      } catch (err) {
        console.warn("Microphone access denied", err);
        const toast = document.getElementById('lang-toast');
        const toastText = document.getElementById('lang-toast-text');
        if (toast && toastText) {
           toastText.textContent = 'Microphone access is required for voice journaling';
           toast.classList.add('show');
           setTimeout(() => toast.classList.remove('show'), 3000);
        }
      }
    }

    stopRecording() {
      if (this.mediaRecorder) {
        this.mediaRecorder.stop();
        this.mediaRecorder.stream.getTracks().forEach(t => t.stop());
      }
      if (this.ws && this.ws.readyState === WebSocket.OPEN) {
        this.ws.send(JSON.stringify({ type: 'end' }));
      }
      this.isRecording = false;
      this.querySelector('#record-view').classList.remove('is-recording');
      
      const langDict = translations[this.currentLang] || translations['en'];
      this.querySelector('#status-text').textContent = langDict.status_processing || "Processing…";
      
      if (window.stopVoiceFluid) window.stopVoiceFluid();
      if (window.stopOpticalVitals) window.stopOpticalVitals();
    }

    renderResponse(data) {
      this.querySelector('#record-view').classList.add('hidden');
      
      // Ergonomic Reset UI injection
      if (data.responseType === 'ergonomic_reset' || data.content.includes('[ACTION: ERGONOMIC_RESET]')) {
         window.triggerErgonomicReset();
      } else if (data.responseType === 'trading_reset' || data.content.includes('[ACTION: TRADING_RESET]')) {
         if (window.triggerTradingReset) window.triggerTradingReset();
      } else if (data.responseType === 'vocal_cooldown' || data.content.includes('[ACTION: VOCAL_COOLDOWN]')) {
         if (window.triggerVocalCooldown) window.triggerVocalCooldown();
      } else if (data.responseType === 'transit_grounding' || data.content.includes('[ACTION: TRANSIT_GROUNDING]')) {
         if (window.triggerTransitGrounding) window.triggerTransitGrounding();
      }
      
      if (data.responseType === 'immersive_room') {
         if (window.startImmersiveRoom) window.startImmersiveRoom();
         return; // Skip standard response rendering
      }
      
      const rv = this.querySelector('#response-view');
      rv.classList.remove('hidden');
      rv.classList.add('flex');
      
      this.querySelector('#response-heading').textContent = `Detected: ${data.emotion}`;
      this.querySelector('#response-content-area').textContent = data.content;
      
      // Client-Side Voice Synthesis (Sprint 1)
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel(); // Stop any ongoing speech
        const utterance = new SpeechSynthesisUtterance(data.content);
        utterance.lang = this.currentLang;
        utterance.rate = 0.9; // Slightly slower, calming pace
        utterance.pitch = 0.95; 
        window.speechSynthesis.speak(utterance);
      }
      
      if (data.responseType === 'breathing') {
        this.querySelector('#breathing-circle-container').classList.remove('hidden');
        startHapticPacing(10000); // Start 10s haptic breathe cycle
      }
      
      if (data.distressFlag) {
        const crisis = this.querySelector('#crisis-handoff');
        if (crisis) {
          crisis.classList.remove('hidden');
          if (window.updateCrisisUI) window.updateCrisisUI(this.currentLang);
        }
      }
    }

    resetUI() {
      this.querySelector('#response-view').classList.add('hidden');
      this.querySelector('#response-view').classList.remove('flex');
      this.querySelector('#record-view').classList.remove('hidden');
      this.querySelector('#breathing-circle-container').classList.add('hidden');
      const crisis = this.querySelector('#crisis-handoff');
      if (crisis) crisis.classList.add('hidden');
      
      const langDict = translations[this.currentLang] || translations['en'];
      this.querySelector('#status-text').textContent = langDict.status_start || "Tap the microphone to start.";
      stopHapticPacing();
    }
  }

  customElements.define('mood-recorder', MoodRecorder);
</script>
