---
// src/components/TransitGrounding.astro
---
<button id="travel-relief-toggle" class="w-full py-4 bg-zinc-800 text-zinc-300 font-bold rounded-xl hover:bg-zinc-700 transition-colors uppercase tracking-wider text-sm shadow-sm border border-zinc-700 flex justify-center items-center gap-2">
  <svg class="w-5 h-5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
  <span id="travel-relief-text">travel relief sound</span>
</button>

<script>
  let transitOscillators = [];
  let transitHapticInterval = null;
  let isTransitOn = false;

  document.getElementById('travel-relief-toggle')?.addEventListener('click', (e) => {
    const btn = e.currentTarget;
    const textSpan = document.getElementById('travel-relief-text');
    
    if (!isTransitOn) {
      isTransitOn = true;
      btn.classList.replace('bg-zinc-800', 'bg-orange-600');
      btn.classList.replace('hover:bg-zinc-700', 'hover:bg-orange-700');
      btn.classList.replace('text-zinc-300', 'text-white');
      btn.classList.replace('border-zinc-700', 'border-orange-500');
      if (textSpan) textSpan.textContent = 'travel relief sound (ON)';
      
      // Start audio
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        const ctx = new AudioContext();
        
        const leftOsc = ctx.createOscillator();
        const rightOsc = ctx.createOscillator();
        const leftPan = ctx.createStereoPanner();
        const rightPan = ctx.createStereoPanner();
        
        leftOsc.type = 'sine';
        rightOsc.type = 'sine';
        leftOsc.frequency.setValueAtTime(432.0, ctx.currentTime);
        rightOsc.frequency.setValueAtTime(436.0, ctx.currentTime);
        
        leftPan.pan.value = -1;
        rightPan.pan.value = 1;
        
        leftOsc.connect(leftPan).connect(ctx.destination);
        rightOsc.connect(rightPan).connect(ctx.destination);
        
        leftOsc.start();
        rightOsc.start();
        transitOscillators = [leftOsc, rightOsc, ctx];
      } catch(err) {
        console.warn("Binaural beat failed to start", err);
      }
      
      // Start haptics
      if (navigator.vibrate) {
         transitHapticInterval = setInterval(() => {
            navigator.vibrate([300, 2000, 300]);
         }, 4000);
      }

      // Voice response
      const recorder = document.querySelector('mood-recorder');
      if (recorder && recorder.renderResponse) {
        recorder.renderResponse({
          valence: -0.2, arousal: 0.6, emotion: "transit_overload",
          responseType: "transit_grounding",
          content: "Manual transit relief activated. Grounding your nervous system.",
          distressFlag: false
        });
      }
      
    } else {
      isTransitOn = false;
      btn.classList.replace('bg-orange-600', 'bg-zinc-800');
      btn.classList.replace('hover:bg-orange-700', 'hover:bg-zinc-700');
      btn.classList.replace('text-white', 'text-zinc-300');
      btn.classList.replace('border-orange-500', 'border-zinc-700');
      if (textSpan) textSpan.textContent = 'travel relief sound';
      
      // Stop audio
      if (transitOscillators.length > 0) {
        transitOscillators[0].stop();
        transitOscillators[1].stop();
        if(transitOscillators[2].state !== 'closed') transitOscillators[2].close();
        transitOscillators = [];
      }
      
      // Stop haptics
      if (transitHapticInterval) {
         clearInterval(transitHapticInterval);
         transitHapticInterval = null;
         if(navigator.vibrate) navigator.vibrate(0);
      }
      
      // Instantly kill TTS / Background audio
      window.speechSynthesis.cancel();
      
      // Also notify mood-recorder to stop any playing audio elements if any
      const recorder = document.querySelector('mood-recorder');
      if (recorder && recorder.stopAllAudio) {
         recorder.stopAllAudio();
      }
    }
  });
</script>
