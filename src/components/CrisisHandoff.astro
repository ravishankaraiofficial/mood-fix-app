---
// src/components/CrisisHandoff.astro
---

<div id="crisis-handoff" class="hidden w-full mt-6 p-6 bg-red-50 border border-red-200 rounded-xl text-center shadow-sm transition-all duration-300">
  <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
  </div>
  <h3 id="crisis-title" class="text-lg font-semibold text-red-900 mb-2">You are not alone.</h3>
  <p id="crisis-desc" class="text-sm text-red-800 mb-6">If you are in extreme distress, please reach out immediately.</p>
  
  <a id="crisis-call-btn" href="tel:988" class="inline-flex items-center justify-center px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-medium rounded-full transition-colors shadow-sm w-full max-w-xs mx-auto touch-manipulation">
    Call Support Helpline
  </a>
</div>

<script>
  // @ts-nocheck
  window.updateCrisisUI = function(langCode) {
    const title = document.getElementById('crisis-title');
    const desc = document.getElementById('crisis-desc');
    const btn = document.getElementById('crisis-call-btn');
    
    if (!title || !desc || !btn) return;
    
    const mappings = {
      en: { t: "You are not alone.", d: "Please reach out for immediate support.", b: "Call Helpline", num: "tel:988" },
      hi: { t: "आप अकेले नहीं हैं।", d: "कृपया तुरंत सहायता के लिए संपर्क करें।", b: "हेल्पलाइन पर कॉल करें", num: "tel:112" },
      bn: { t: "আপনি একা নন।", d: "অবিলম্বে সহায়তার জন্য যোগাযোগ করুন।", b: "হেল্পলাইনে কল করুন", num: "tel:112" },
      ur: { t: "آپ اکیلے نہیں ہیں۔", d: "براہ کرم فوری مدد کے لیے رابطہ کریں۔", b: "ہیلپ لائن پر کال کریں", num: "tel:112" }
    };
    
    const data = mappings[langCode] || mappings['en'];
    title.textContent = data.t;
    desc.textContent = data.d;
    btn.textContent = data.b;
    btn.setAttribute('href', data.num);
  };
</script>
