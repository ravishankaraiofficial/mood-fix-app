---
// src/components/VoiceJournal.astro
---

<div id="voice-journal" class="w-full max-w-md mx-auto mt-8 bg-white p-6 rounded-2xl shadow-sm border border-orange-100">
  <div class="flex justify-between items-start mb-4">
    <div>
      <h3 class="text-xl font-semibold text-orange-900">Reflection Journal</h3>
      <p class="text-sm text-orange-800/70">Speak freely. Locally encrypted with smart tags.</p>
    </div>
    <div id="journal-status" class="w-3 h-3 rounded-full bg-gray-300"></div>
  </div>

  <div class="relative w-full h-32 mb-4">
    <textarea id="journal-text" class="w-full h-full p-3 border border-orange-200 rounded-xl bg-orange-50/50 text-orange-900 placeholder:text-orange-900/30 resize-none focus:outline-none focus:ring-2 focus:ring-orange-300 transition-shadow" placeholder="What's on your mind?"></textarea>
  </div>

  <div id="smart-tags" class="flex flex-wrap gap-2 mb-4 min-h-[28px]">
    <!-- Tags injected here -->
  </div>

  <div class="flex gap-3">
    <button id="vj-mic-btn" class="flex-1 py-3 bg-orange-100 text-orange-800 font-medium rounded-xl hover:bg-orange-200 transition-colors flex justify-center items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
      </svg>
      <span id="vj-mic-text">Start Dictation</span>
    </button>
    <button id="vj-save-btn" class="flex-1 py-3 bg-orange-600 text-white font-medium rounded-xl hover:bg-orange-700 transition-colors">
      Save Encrypted
    </button>
  </div>

  <div class="mt-8 border-t border-orange-100 pt-6">
    <h4 class="text-lg font-semibold text-orange-900 mb-2">Chat with your past self</h4>
    <div class="flex gap-2">
       <input id="rag-query" type="text" class="flex-1 p-3 border border-orange-200 rounded-xl bg-orange-50/50 text-orange-900 placeholder:text-orange-900/40 focus:outline-none focus:ring-2 focus:ring-orange-300 transition-shadow text-sm" placeholder="e.g. How did I handle stress last month?">
       <button id="rag-search-btn" class="px-5 py-3 bg-indigo-600 text-white font-medium rounded-xl hover:bg-indigo-700 transition-colors shadow-sm active:scale-95">Ask</button>
    </div>
    <div id="rag-response" class="mt-4 p-4 bg-indigo-50 border border-indigo-100 rounded-xl text-indigo-900 hidden text-sm leading-relaxed"></div>
  </div>
</div>

<script>
  // @ts-nocheck
  import { saveJournal } from '../lib/db';

  const micBtn = document.getElementById('vj-mic-btn');
  const micText = document.getElementById('vj-mic-text');
  const textArea = document.getElementById('journal-text');
  const tagsContainer = document.getElementById('smart-tags');
  const statusDot = document.getElementById('journal-status');
  const saveBtn = document.getElementById('vj-save-btn');

  let recognition = null;
  let isRecording = false;
  let extractedTags = [];

  const THEMATIC_KEYWORDS = {
    'work': ['work', 'boss', 'meeting', 'project', 'office', 'career'],
    'sleep': ['sleep', 'tired', 'exhausted', 'insomnia', 'night'],
    'relationship': ['relationship', 'partner', 'friend', 'fight', 'family'],
    'anxious': ['anxious', 'stress', 'overwhelmed', 'panic', 'nervous', 'worry'],
    'health': ['health', 'sick', 'pain', 'body', 'diet']
  };

  function extractTags(text) {
    const lower = text.toLowerCase();
    const tags = new Set();
    
    for (const [tag, words] of Object.entries(THEMATIC_KEYWORDS)) {
      if (words.some(w => lower.includes(w))) {
        tags.add(tag);
      }
    }
    
    extractedTags = Array.from(tags);
    tagsContainer.innerHTML = '';
    extractedTags.forEach(t => {
      const span = document.createElement('span');
      span.className = 'px-2.5 py-1 bg-orange-100 text-orange-800 text-xs font-semibold rounded-full capitalize';
      span.textContent = '#' + t;
      tagsContainer.appendChild(span);
    });
  }

  // Graceful degradation for Speech Recognition
  if ('SpeechRecognition' in window || 'webkitSpeechRecognition' in window) {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    
    recognition.onstart = () => {
      isRecording = true;
      micText.textContent = 'Stop Dictation';
      micBtn.classList.replace('bg-orange-100', 'bg-red-100');
      micBtn.classList.replace('text-orange-800', 'text-red-800');
      statusDot.classList.replace('bg-gray-300', 'bg-red-500');
      statusDot.classList.add('animate-pulse');
    };

    recognition.onresult = (event) => {
      let finalTranscript = '';
      for (let i = event.resultIndex; i < event.results.length; ++i) {
        if (event.results[i].isFinal) {
          finalTranscript += event.results[i][0].transcript + ' ';
        }
      }
      if (finalTranscript) {
        textArea.value += finalTranscript;
        extractTags(textArea.value);
      }
    };

    recognition.onerror = (e) => console.warn('Speech recognition error', e);
    
    recognition.onend = () => {
      isRecording = false;
      micText.textContent = 'Start Dictation';
      micBtn.classList.replace('bg-red-100', 'bg-orange-100');
      micBtn.classList.replace('text-red-800', 'text-orange-800');
      statusDot.classList.replace('bg-red-500', 'bg-gray-300');
      statusDot.classList.remove('animate-pulse');
      extractTags(textArea.value); // Final sweep
    };

    micBtn.addEventListener('click', () => {
      if (isRecording) {
        recognition.stop();
      } else {
        const lang = localStorage.getItem('moodReliefLang') || 'en';
        // Map simple codes to specific locales (e.g., 'en' -> 'en-US', 'hi' -> 'hi-IN')
        const locales = { en: 'en-US', hi: 'hi-IN', bn: 'bn-IN', ta: 'ta-IN' }; 
        recognition.lang = locales[lang] || lang;
        recognition.start();
      }
    });
  } else {
    // Feature missing: hide mic button
    micBtn.classList.add('hidden');
  }

  // Live text parsing for manual typing
  textArea.addEventListener('input', () => extractTags(textArea.value));

  // Save to IndexedDB with Vector Embedding
  saveBtn.addEventListener('click', async () => {
    if (!textArea.value.trim()) return;
    saveBtn.textContent = 'Generating Embedding...';
    saveBtn.disabled = true;
    
    // Aggressively lazy load the transformer module
    const { generateEmbedding } = await import('../lib/ragEngine');
    const embedding = await generateEmbedding(textArea.value);
    
    saveBtn.textContent = 'Encrypting...';
    const success = await saveJournal(textArea.value, extractedTags, embedding);
    
    if (success) {
      textArea.value = '';
      tagsContainer.innerHTML = '';
      extractedTags = [];
      saveBtn.textContent = 'Saved Locally!';
      setTimeout(() => {
        saveBtn.textContent = 'Save Encrypted';
        saveBtn.disabled = false;
      }, 2000);
    } else {
      saveBtn.textContent = 'Error';
      setTimeout(() => {
        saveBtn.textContent = 'Save Encrypted';
        saveBtn.disabled = false;
      }, 2000);
    }
  });

  // RAG Semantic Search
  const ragQuery = document.getElementById('rag-query');
  const ragSearchBtn = document.getElementById('rag-search-btn');
  const ragResponse = document.getElementById('rag-response');

  ragSearchBtn.addEventListener('click', async () => {
    const q = ragQuery.value.trim();
    if (!q) return;
    
    ragSearchBtn.textContent = 'Searching...';
    ragSearchBtn.disabled = true;
    ragResponse.classList.remove('hidden');
    ragResponse.textContent = 'Vectorizing query and searching encrypted logs statelessly...';

    const { getRecentJournals } = await import('../lib/db');
    const { vectorSearch } = await import('../lib/ragEngine');

    // Get up to 30 days of journals
    const journals = await getRecentJournals(720);
    const topEntries = await vectorSearch(q, journals, 3);
    
    if (topEntries.length === 0 || topEntries[0].similarity < 0.1) {
      ragResponse.textContent = "I couldn't find enough past context in your local vault for this question.";
      ragSearchBtn.textContent = 'Ask';
      ragSearchBtn.disabled = false;
      return;
    }

    let contextStr = "Here are the user's past journal entries relevant to their question:\n\n";
    topEntries.forEach((entry, i) => {
       contextStr += `Entry ${i+1} (${new Date(entry.timestamp).toLocaleDateString()}): "${entry.data.text}"\n\n`;
    });
    
    ragResponse.textContent = 'Synthesizing response via secure stream...';
    
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const ws = new WebSocket(`${protocol}//${window.location.host}/api/stream`);
    
    ws.onopen = () => {
      ws.send(JSON.stringify({ 
         type: 'start', 
         language: localStorage.getItem('moodReliefLang') || 'en',
         environment: { ragContext: contextStr, query: q } 
      }));
      // send a tiny blank audio chunk to satisfy binary listener
      ws.send(new Uint8Array([0]));
      ws.send(JSON.stringify({ type: 'end' }));
    };
    
    ws.onmessage = (e) => {
      try {
        const data = JSON.parse(e.data);
        ragResponse.textContent = data.content;
      } catch(err) {}
      ws.close();
    };
    
    ws.onclose = () => {
       ragSearchBtn.textContent = 'Ask';
       ragSearchBtn.disabled = false;
    };
  });
</script>
