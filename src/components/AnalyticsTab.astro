---
// src/components/AnalyticsTab.astro
import CanvasExport from './CanvasExport.astro';
---

<div id="analytics-panel" class="hidden w-full max-w-md mx-auto mt-8 p-6 bg-white rounded-2xl shadow-sm border border-orange-100 transition-all">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-orange-900">Your Insights</h2>
    <span class="text-xs font-medium px-2 py-1 bg-green-100 text-green-800 rounded-full flex items-center gap-1" title="All data is encrypted and stays on this device">
      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
      Private
    </span>
  </div>

  <div class="mb-8">
    <h3 class="text-sm font-medium text-orange-800 mb-3">14-Day Activity</h3>
    <div id="mood-calendar" class="grid grid-cols-7 gap-2">
      <!-- Squares injected via JS -->
    </div>
    <p class="text-xs text-gray-500 mt-3 text-center">Your emotional matrix trends are stored locally.</p>
  </div>

  <div class="space-y-4">
    <button id="phq9-btn" class="w-full py-3 px-4 bg-orange-50 hover:bg-orange-100 text-orange-900 rounded-lg text-sm font-medium text-left flex justify-between transition-colors">
      Take PHQ-9 (Depression Screener)
      <span>→</span>
    </button>
    <button id="gad7-btn" class="w-full py-3 px-4 bg-orange-50 hover:bg-orange-100 text-orange-900 rounded-lg text-sm font-medium text-left flex justify-between transition-colors">
      Take GAD-7 (Anxiety Screener)
      <span>→</span>
    </button>
  </div>

  <div class="mt-8 flex gap-4 justify-center">
    <button class="px-4 py-2 bg-white border border-orange-200 text-orange-900 rounded-lg text-sm font-medium hover:bg-orange-50 shadow-sm transition-colors">PHQ-9 Screener</button>
    <button class="px-4 py-2 bg-white border border-orange-200 text-orange-900 rounded-lg text-sm font-medium hover:bg-orange-50 shadow-sm transition-colors">GAD-7 Screener</button>
  </div>

  <!-- Sprint 1: Local Image Export Engine -->
  <CanvasExport />
</div>

<script>
  import { getRecentMoodLogs } from '../lib/db';
  
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      // 14 days = 336 hours
      const logs = await getRecentMoodLogs(336);
      const calendar = document.getElementById('mood-calendar');
      
      if (calendar) {
        // Simple visualization: 14 blank days, fill in colors based on logs
        // Map logs by day offset from today
        const now = Date.now();
        const MS_PER_DAY = 24 * 60 * 60 * 1000;
        
        const dayCounts = new Array(14).fill(0);
        logs.forEach(log => {
          const daysAgo = Math.floor((now - log.timestamp) / MS_PER_DAY);
          if (daysAgo >= 0 && daysAgo < 14) {
            dayCounts[13 - daysAgo]++;
          }
        });

        for (let i = 0; i < 14; i++) {
          const sq = document.createElement('div');
          // Base style
          sq.className = 'w-full aspect-square rounded-md transition-colors duration-300';
          
          if (dayCounts[i] === 0) {
            sq.classList.add('bg-orange-50');
          } else if (dayCounts[i] === 1) {
            sq.classList.add('bg-orange-200');
          } else {
            sq.classList.add('bg-orange-400');
          }
          
          calendar.appendChild(sq);
        }
      }
    } catch (e) {
      console.warn("Could not load analytics logs", e);
    }
  });
</script>
