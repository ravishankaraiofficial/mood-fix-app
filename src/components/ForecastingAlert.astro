---
// src/components/ForecastingAlert.astro
---
<div id="forecasting-alert" class="hidden w-full max-w-md mx-auto mt-4 mb-2 p-4 bg-gradient-to-r from-orange-100 to-rose-100 dark:from-gray-800 dark:to-gray-700 border border-orange-200 dark:border-gray-600 rounded-2xl shadow-sm flex items-center justify-between animate-fade-in">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <svg class="w-4 h-4 text-orange-600 dark:text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <h4 class="text-sm font-bold text-orange-900 dark:text-gray-100">Preemptive Grounding</h4>
    </div>
    <p class="text-xs text-orange-800/80 dark:text-gray-300">Based on your physiological patterns, you might experience an arousal spike soon. Let's get ahead of it.</p>
  </div>
  <button id="preventative-breathe-btn" class="ml-4 px-4 py-2 bg-orange-600 dark:bg-orange-500 text-white text-xs font-bold rounded-xl hover:bg-orange-700 dark:hover:bg-orange-600 whitespace-nowrap shadow-md active:scale-95 transition-transform">
    Breathe
  </button>
</div>

<script>
  // @ts-nocheck
  import { getRecentMoodLogs } from '../lib/db';
  
  // Aggressively lazy load the ML forecasting engine during idle time
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => runForecast());
  } else {
    setTimeout(runForecast, 5000);
  }
  
  async function runForecast() {
    try {
      // Need history from the last 14 days (14 * 24 = 336h)
      const logs = await getRecentMoodLogs(336);
      if (logs.length < 5) return;
      
      const { trainAndPredictForecast } = await import('../lib/forecasting');
      const stressProbability = await trainAndPredictForecast(logs);
      
      // If > 65% probability of an anxiety/stress event, show proactive card
      if (stressProbability !== null && stressProbability > 0.65) {
        document.getElementById('forecasting-alert').classList.remove('hidden');
      }
    } catch(e) {
      console.warn("Local forecasting skipped (ML assets pending or unsupported)", e);
    }
  }
  
  document.getElementById('preventative-breathe-btn')?.addEventListener('click', () => {
    window.scrollTo(0,0);
    const recorder = document.querySelector('mood-recorder');
    if (recorder && recorder.renderResponse) {
       document.getElementById('forecasting-alert').classList.add('hidden');
       recorder.renderResponse({
         valence: 0, arousal: 0, emotion: "proactive",
         responseType: "breathing",
         content: "Let's take a preventative breath to stay grounded.",
         distressFlag: false
       });
    }
  });
</script>
