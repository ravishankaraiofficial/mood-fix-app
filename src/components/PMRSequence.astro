---
// src/components/PMRSequence.astro
---

<div id="pmr-container" class="w-full max-w-md mx-auto mt-8 bg-white p-6 rounded-2xl shadow-sm border border-indigo-100">
  <div class="flex justify-between items-start mb-4">
    <div>
      <h3 class="text-xl font-semibold text-indigo-900">Voice-Driven PMR</h3>
      <p class="text-sm text-indigo-800/70">Say "Next", "Done", or "Okay" to advance.</p>
    </div>
    <div id="pmr-status" class="w-3 h-3 rounded-full bg-gray-300"></div>
  </div>

  <div class="text-center py-8 bg-indigo-50 rounded-xl mb-4 transition-all duration-300" id="pmr-display">
    <div id="pmr-phase-text" class="text-2xl font-bold text-indigo-900 mb-2">Ready</div>
    <div id="pmr-instruction" class="text-indigo-800 px-4">Tap Start to begin progressive muscle relaxation.</div>
  </div>

  <div class="flex gap-3">
    <button id="pmr-start-btn" class="flex-1 py-3 bg-indigo-100 text-indigo-800 font-medium rounded-xl hover:bg-indigo-200 transition-colors">
      Start PMR
    </button>
    <button id="pmr-stop-btn" class="flex-1 py-3 bg-red-100 text-red-800 font-medium rounded-xl hover:bg-red-200 transition-colors hidden">
      Stop Session
    </button>
  </div>
</div>

<script>
  // @ts-nocheck
  const pmrPhases = [
    { name: "Hands", tense: "Tense your hands into tight fists.", release: "Release and let the tension flow out." },
    { name: "Shoulders", tense: "Pull your shoulders up to your ears.", release: "Let them drop completely." },
    { name: "Face", tense: "Squeeze your eyes shut and scrunch your face.", release: "Relax your facial muscles." },
    { name: "Legs", tense: "Point your toes and tense your calves.", release: "Let your legs go limp." },
    { name: "Done", tense: "Take a deep breath. You are fully relaxed.", release: "" }
  ];

  let currentPhaseIdx = 0;
  let isTensing = true;
  let recognition = null;
  let synth = window.speechSynthesis;

  const startBtn = document.getElementById('pmr-start-btn');
  const stopBtn = document.getElementById('pmr-stop-btn');
  const phaseText = document.getElementById('pmr-phase-text');
  const instructionText = document.getElementById('pmr-instruction');
  const statusDot = document.getElementById('pmr-status');
  const displayBox = document.getElementById('pmr-display');

  function speak(text) {
    if (synth.speaking) synth.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    // Use the stored language if available
    const lang = localStorage.getItem('moodReliefLang') || 'en';
    const locales = { en: 'en-US', hi: 'hi-IN', bn: 'bn-IN', ta: 'ta-IN' }; 
    utterance.lang = locales[lang] || lang;
    synth.speak(utterance);
  }

  function advancePMR() {
    if (currentPhaseIdx >= pmrPhases.length - 1 && !isTensing) {
      stopPMR();
      return;
    }

    const phase = pmrPhases[currentPhaseIdx];
    
    if (isTensing) {
      phaseText.textContent = phase.name + " (Tense)";
      instructionText.textContent = phase.tense;
      displayBox.classList.replace('bg-indigo-50', 'bg-red-50');
      speak(phase.tense);
      isTensing = false;
    } else {
      phaseText.textContent = phase.name + " (Release)";
      instructionText.textContent = phase.release;
      displayBox.classList.replace('bg-red-50', 'bg-indigo-50');
      speak(phase.release);
      isTensing = true;
      currentPhaseIdx++;
    }
  }

  function stopPMR() {
    if (recognition) {
      recognition.stop();
      recognition = null;
    }
    synth.cancel();
    startBtn.classList.remove('hidden');
    stopBtn.classList.add('hidden');
    phaseText.textContent = "Done";
    instructionText.textContent = "Great job.";
    statusDot.classList.replace('bg-green-500', 'bg-gray-300');
    statusDot.classList.remove('animate-pulse');
    displayBox.classList.remove('bg-red-50');
    displayBox.classList.add('bg-indigo-50');
  }

  function startPMR() {
    currentPhaseIdx = 0;
    isTensing = true;
    startBtn.classList.add('hidden');
    stopBtn.classList.remove('hidden');
    statusDot.classList.replace('bg-gray-300', 'bg-green-500');
    statusDot.classList.add('animate-pulse');

    if ('SpeechRecognition' in window || 'webkitSpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = false;
      
      const lang = localStorage.getItem('moodReliefLang') || 'en';
      const locales = { en: 'en-US', hi: 'hi-IN', bn: 'bn-IN', ta: 'ta-IN' }; 
      recognition.lang = locales[lang] || lang;
      
      recognition.onresult = (event) => {
        const last = event.results.length - 1;
        const transcript = event.results[last][0].transcript;
        const cleanTranscript = transcript.toLowerCase().trim().replace(/[.,!?]/g, "");
        const commands = ['next', 'done', 'okay', 'ok', 'yes', 'आगे', 'हो गया'];
        
        if (commands.some(cmd => cleanTranscript.includes(cmd))) {
          advancePMR();
          // Flush the continuous speech buffer by gracefully restarting
          try {
            recognition.stop();
          } catch(e) {}
        }
      };

      recognition.onerror = (e) => console.warn('PMR Speech error', e);
      // Auto-restart if it drops, unless stopped
      recognition.onend = () => {
        if (stopBtn.classList.contains('hidden') === false && recognition) {
          try { recognition.start(); } catch(e) {}
        }
      };
      
      try { recognition.start(); } catch(e) {}
    }
    
    advancePMR();
  }

  startBtn.addEventListener('click', startPMR);
  stopBtn.addEventListener('click', stopPMR);
</script>
