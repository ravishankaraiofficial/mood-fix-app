---
// src/pages/roadmap.astro
import '../styles/global.css';
---
<html lang="en">
<head>
  <title>V3.0 Roadmap Architect</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 12px;
      width: 12px;
      border-radius: 50%;
      background: #4b5563;
      cursor: pointer;
    }
  </style>
</head>
<body class="bg-gray-50 p-4 md:p-8 min-h-screen text-gray-900 font-sans">
  <div class="max-w-6xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2">V3.0 Feature Strategy & Roadmap Architect</h1>
      <p class="text-gray-600">Prioritize the 10 Next-Gen features. Adjust the sliders to see the scatter plot update in real-time and generate your optimal sprint list.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Sliders Panel -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 lg:col-span-7">
        <h2 class="text-xl font-semibold mb-6">Feature Evaluation</h2>
        <div id="sliders-container" class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[700px] overflow-y-auto pr-2">
          <!-- Injected via JS -->
        </div>
      </div>

      <!-- Visualization Panel -->
      <div class="space-y-8 lg:col-span-5">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
          <h2 class="text-xl font-semibold mb-6">Priority Scatter Plot</h2>
          
          <div class="flex">
            <!-- Y-axis Label -->
            <div class="flex items-center justify-center writing-mode-vertical -rotate-180 pr-4 text-xs font-medium text-gray-500" style="writing-mode: vertical-rl;">
              High Value →
            </div>
            
            <div class="w-full">
              <div class="relative w-full aspect-square bg-gray-50 border border-gray-300 rounded-lg overflow-hidden shadow-inner">
                <!-- Grid Lines -->
                <div class="absolute inset-0 flex flex-col justify-between pointer-events-none opacity-20 py-[10%]">
                  <div class="w-full h-px bg-gray-400"></div><div class="w-full h-px bg-gray-400"></div><div class="w-full h-px bg-gray-400"></div><div class="w-full h-px bg-gray-400"></div>
                </div>
                <div class="absolute inset-0 flex justify-between pointer-events-none opacity-20 px-[10%]">
                  <div class="h-full w-px bg-gray-400"></div><div class="h-full w-px bg-gray-400"></div><div class="h-full w-px bg-gray-400"></div><div class="h-full w-px bg-gray-400"></div>
                </div>
                <!-- Crosshairs -->
                <div class="absolute top-1/2 left-0 w-full h-px bg-gray-300 pointer-events-none"></div>
                <div class="absolute top-0 left-1/2 w-px h-full bg-gray-300 pointer-events-none"></div>
                
                <!-- Quadrant Labels -->
                <div class="absolute top-3 left-3 text-[10px] font-bold text-green-600/60 uppercase tracking-wider">Quick Wins</div>
                <div class="absolute top-3 right-3 text-[10px] font-bold text-orange-500/60 uppercase tracking-wider">Major Projects</div>
                <div class="absolute bottom-3 left-3 text-[10px] font-bold text-gray-400/60 uppercase tracking-wider">Fill-ins</div>
                <div class="absolute bottom-3 right-3 text-[10px] font-bold text-red-400/60 uppercase tracking-wider">Time Sinks</div>
                
                <svg id="scatter-plot" class="w-full h-full absolute inset-0" viewBox="0 0 100 100">
                  <!-- Dots injected via JS -->
                </svg>
              </div>
              <!-- X-axis Label -->
              <div class="flex justify-between text-xs font-medium text-gray-500 mt-4">
                <span>Low Effort</span>
                <span>High Effort</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
          <h2 class="text-xl font-semibold mb-4">Recommended Sprint List</h2>
          <ol id="sprint-list" class="list-decimal pl-5 space-y-3 text-sm text-gray-700">
            <!-- Injected via JS -->
          </ol>
        </div>
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    const features = [
      { id: 'f1', name: 'Voice Synthesis (TTS)', v: 8, e: 4 },
      { id: 'f2', name: 'Generative Ambient Audio', v: 7, e: 6 },
      { id: 'f3', name: 'Voice-Driven PMR', v: 9, e: 8 },
      { id: 'f4', name: 'Canvas Streak Export', v: 5, e: 5 },
      { id: 'f5', name: 'Gamified Visual Rewards', v: 6, e: 3 },
      { id: 'f6', name: 'Voice-Activated Journaling', v: 8, e: 9 },
      { id: 'f7', name: 'Offline-First PWA', v: 10, e: 7 },
      { id: 'f8', name: 'Circadian Adapters', v: 6, e: 2 },
      { id: 'f9', name: 'Multi-User Profiles (Crypto)', v: 7, e: 8 },
      { id: 'f10', name: 'WebRTC P2P Sympathy Sync', v: 9, e: 10 }
    ];

    const colors = [
      '#ef4444', // red
      '#f97316', // orange
      '#eab308', // yellow
      '#84cc16', // lime
      '#22c55e', // green
      '#06b6d4', // cyan
      '#3b82f6', // blue
      '#6366f1', // indigo
      '#a855f7', // purple
      '#ec4899'  // pink
    ];

    function render() {
      const sCont = document.getElementById('sliders-container');
      const plot = document.getElementById('scatter-plot');
      const list = document.getElementById('sprint-list');

      sCont.innerHTML = '';
      plot.innerHTML = '';
      list.innerHTML = '';

      // Render Sliders
      features.forEach((f, i) => {
        const div = document.createElement('div');
        div.className = 'p-4 bg-gray-50 rounded-xl border border-gray-200 transition-colors hover:border-gray-300';
        div.innerHTML = `
          <div class="flex justify-between items-center mb-4">
            <span class="font-semibold text-sm flex items-center gap-2 text-gray-800">
              <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: ${colors[i]}"></span>
              ${f.name}
            </span>
          </div>
          <div class="space-y-4">
            <div>
              <label class="text-xs text-gray-500 flex justify-between mb-1">
                <span>User Value</span> 
                <span class="font-bold text-gray-700 bg-white px-2 rounded shadow-sm border border-gray-100">${f.v}</span>
              </label>
              <input type="range" min="1" max="10" value="${f.v}" class="w-full h-1.5 bg-green-200 rounded-lg appearance-none outline-none" oninput="window.updateF('${f.id}', 'v', this.value)">
            </div>
            <div>
              <label class="text-xs text-gray-500 flex justify-between mb-1">
                <span>Effort</span> 
                <span class="font-bold text-gray-700 bg-white px-2 rounded shadow-sm border border-gray-100">${f.e}</span>
              </label>
              <input type="range" min="1" max="10" value="${f.e}" class="w-full h-1.5 bg-red-200 rounded-lg appearance-none outline-none" oninput="window.updateF('${f.id}', 'e', this.value)">
            </div>
          </div>
        `;
        sCont.appendChild(div);

        // Render Dot on Scatter Plot
        // Map 1-10 to 5%-95% of SVG viewBox to keep dots inside edges
        const cx = 5 + ((f.e - 1) / 9) * 90;
        const cy = 95 - ((f.v - 1) / 9) * 90;
        
        plot.innerHTML += `
          <circle cx="${cx}" cy="${cy}" r="2.5" fill="${colors[i]}" stroke="#fff" stroke-width="0.5" class="transition-all duration-300 ease-out"></circle>
          <text x="${cx + 3}" y="${cy - 2}" font-size="2.5" font-weight="600" fill="#4b5563" class="pointer-events-none transition-all duration-300 ease-out">${f.name.split(' ')[0]}</text>
        `;
      });

      // Render List (Sorted by Score: Value - (Effort * 0.8))
      // High value, low effort gets highest score.
      const sorted = [...features].sort((a, b) => {
        const scoreA = a.v - (a.e * 0.8); 
        const scoreB = b.v - (b.e * 0.8);
        return scoreB - scoreA;
      });

      sorted.forEach((f, i) => {
        const li = document.createElement('li');
        li.className = 'flex justify-between items-center py-1 border-b border-gray-100 last:border-0';
        li.innerHTML = `
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full" style="background-color: ${colors[features.indexOf(f)]}"></span>
            <span class="font-medium ${i < 3 ? 'text-gray-900' : 'text-gray-600'}">${f.name}</span>
          </div>
          <span class="text-xs bg-gray-100 px-2 py-0.5 rounded text-gray-500 font-mono">V${f.v}/E${f.e}</span>
        `;
        list.appendChild(li);
      });
    }

    window.updateF = (id, prop, val) => {
      const f = features.find(x => x.id === id);
      if (f) f[prop] = parseInt(val);
      render(); // Re-render everything smoothly
    };

    document.addEventListener('DOMContentLoaded', render);
  </script>
</body>
</html>
