---
// Homepage
import '../styles/global.css';
import MoodRecorder from '../components/MoodRecorder.astro';
import AnalyticsTab from '../components/AnalyticsTab.astro';
import ForecastingAlert from '../components/ForecastingAlert.astro';
import PostureVision from '../components/PostureVision.astro';
import VoiceJournal from '../components/VoiceJournal.astro';
import PMRSequence from '../components/PMRSequence.astro';
import BilateralStimulation from '../components/BilateralStimulation.astro';
import ErgonomicReset from '../components/ErgonomicReset.astro';
import ImmersiveRoom from '../components/ImmersiveRoom.astro';
import VocalCooldown from '../components/VocalCooldown.astro';
import TransitGrounding from '../components/TransitGrounding.astro';
import TradingFloorReset from '../components/TradingFloorReset.astro';
import DarkModeToggle from '../components/DarkModeToggle.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Mood Relief - You are not alone</title>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      const savedTheme = localStorage.getItem('moodReliefTheme');
      if (savedTheme && savedTheme !== 'default') {
        document.documentElement.classList.add(savedTheme);
      } else if (!document.documentElement.classList.contains('dark')) {
        const h = new Date().getHours();
        if (h >= 21 || h < 6) {
          document.documentElement.classList.add('theme-night');
        }
      }
    </script>
    <!-- Offline-First PWA Registration -->
    <script>
      // @ts-nocheck
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
    <style is:global>
      html.theme-night body {
        background-color: #120909 !important; /* Charcoal */
        color: #ffc4b8 !important;
      }
      html.theme-night .bg-orange-50 { background-color: #1a0f0f !important; }
      html.theme-night .bg-orange-100 { background-color: #2a1515 !important; }
      html.theme-night .text-orange-900 { color: #ffd6cc !important; }
      html.theme-night .text-orange-800 { color: #ffb8a8 !important; }
      html.theme-night .border-orange-200 { border-color: #4a2525 !important; }
      html.theme-night .bg-orange-500 { background-color: #9f1239 !important; /* Crimson */ }
      html.theme-night .bg-white { background-color: #1a0f0f !important; border-color: #3a1515 !important; }
      html.theme-night #lang-toast { background-color: #9f1239 !important; color: #fff !important; }
      
      /* Deep Ocean Calm */
      html.theme-deep-ocean body { background-color: #001f3f !important; color: #00e5ff !important; }
      html.theme-deep-ocean .bg-orange-50 { background-color: #001529 !important; }
      html.theme-deep-ocean .bg-orange-100 { background-color: #002244 !important; }
      html.theme-deep-ocean .text-orange-900 { color: #80d4ff !important; }
      html.theme-deep-ocean .text-orange-800 { color: #4dc3ff !important; }
      html.theme-deep-ocean .border-orange-200 { border-color: #003366 !important; }
      html.theme-deep-ocean .bg-orange-500 { background-color: #00bfff !important; }
      html.theme-deep-ocean .bg-white { background-color: #001529 !important; border-color: #002244 !important; }
      html.theme-deep-ocean #lang-toast { background-color: #00bfff !important; color: #fff !important; }
      html.theme-deep-ocean #breathing-circle { background-color: #00e5ff !important; box-shadow: 0 0 20px #00e5ff !important; mix-blend-mode: normal !important; opacity: 0.9 !important; }
      html.theme-deep-ocean #partner-circle { background-color: #80d4ff !important; mix-blend-mode: normal !important; }

      /* Midnight Forest */
      html.theme-midnight-forest body { background-color: #051a0e !important; color: #50c878 !important; }
      html.theme-midnight-forest .bg-orange-50 { background-color: #03140a !important; }
      html.theme-midnight-forest .bg-orange-100 { background-color: #082615 !important; }
      html.theme-midnight-forest .text-orange-900 { color: #80e5a6 !important; }
      html.theme-midnight-forest .text-orange-800 { color: #50c878 !important; }
      html.theme-midnight-forest .border-orange-200 { border-color: #0a2f1c !important; }
      html.theme-midnight-forest .bg-orange-500 { background-color: #2e8b57 !important; }
      html.theme-midnight-forest .bg-white { background-color: #03140a !important; border-color: #082615 !important; }
      html.theme-midnight-forest #lang-toast { background-color: #2e8b57 !important; color: #fff !important; }
      html.theme-midnight-forest #breathing-circle { background-color: #50c878 !important; box-shadow: 0 0 20px #50c878 !important; mix-blend-mode: normal !important; opacity: 0.9 !important; }
      html.theme-midnight-forest #partner-circle { background-color: #80e5a6 !important; mix-blend-mode: normal !important; }

      /* Desert Dawn */
      html.theme-desert-dawn body { background-color: #fff0e6 !important; color: #b35938 !important; }
      html.theme-desert-dawn .bg-orange-50 { background-color: #ffe6d9 !important; }
      html.theme-desert-dawn .bg-orange-100 { background-color: #ffcca6 !important; }
      html.theme-desert-dawn .text-orange-900 { color: #8c4a32 !important; }
      html.theme-desert-dawn .text-orange-800 { color: #b35938 !important; }
      html.theme-desert-dawn .border-orange-200 { border-color: #ffb380 !important; }
      html.theme-desert-dawn .bg-orange-500 { background-color: #d96638 !important; }
      html.theme-desert-dawn .bg-white { background-color: #fff9f5 !important; border-color: #ffcca6 !important; }
      html.theme-desert-dawn #lang-toast { background-color: #d96638 !important; color: #fff !important; }
      html.theme-desert-dawn #breathing-circle { background-color: #ff9966 !important; box-shadow: 0 0 20px #ff9966 !important; mix-blend-mode: normal !important; opacity: 0.9 !important; }
      html.theme-desert-dawn #partner-circle { background-color: #ffb380 !important; mix-blend-mode: normal !important; }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu&family=Noto+Sans+Bengali&family=Noto+Sans+Devanagari&family=Noto+Sans+Gujarati&family=Noto+Sans+Gurmukhi&family=Noto+Sans+Kannada&family=Noto+Sans+Malayalam&family=Noto+Sans+Oriya&family=Noto+Sans+Tamil&family=Noto+Sans+Telugu&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col items-center justify-center p-6 bg-orange-50 dark:!bg-gray-900 text-ink dark:!text-gray-100 antialiased pb-20 transition-colors duration-1000">
    <!-- Header with Toggles -->
    <header class="w-full max-w-[375px] mx-auto flex justify-end gap-2 mb-4 relative z-50">
      <DarkModeToggle />
      <button id="toggle-posture-btn" class="p-2 text-orange-900/60 hover:text-orange-900 dark:text-gray-400 dark:hover:text-gray-100 transition-colors" aria-label="Toggle Posture Tracking">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </button>
      <button id="toggle-analytics-btn" class="p-2 text-orange-900/60 hover:text-orange-900 dark:text-gray-400 dark:hover:text-gray-100 transition-colors" aria-label="Toggle Analytics">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </button>
    </header>

    <main id="dashboard" class="relative z-10 w-full max-w-lg mx-auto pt-8 pb-32 px-4 space-y-4">
      <PostureVision />
      <MoodRecorder />
      <ForecastingAlert />
      <AnalyticsTab />
      <VoiceJournal />
      <PMRSequence />
      <BilateralStimulation />
      <ErgonomicReset />
      <ImmersiveRoom />
      <VocalCooldown />
      <TransitGrounding />
      <TradingFloorReset />
    </main>

    <footer id="disclaimer-footer" class="fixed bottom-0 left-0 w-full p-4 text-center text-xs text-orange-900/60 bg-orange-50/90 backdrop-blur-sm z-50 border-t border-orange-900/10 transition-all duration-300">
      This is a calming tool, not medical advice. If you are in crisis, please reach out to someone you trust or a local helpline.
    </footer>

    <script>
      // @ts-nocheck
      import { getRecentMoodLogs } from '../lib/db';
      import { startAgitationTracker } from '../lib/agitationTracker';

      startAgitationTracker(() => {
        const recorder = document.querySelector('mood-recorder');
        if (recorder && recorder.renderResponse) {
          recorder.renderResponse({
            valence: -0.5, arousal: 0.8, emotion: "agitated",
            responseType: "breathing",
            content: "I'm detecting some physical restlessness. Let's take a slow breath together.",
            distressFlag: false
          });
        }
      }, () => {
        // Transit detection heuristic triggered
        const recorder = document.querySelector('mood-recorder');
        if (recorder && recorder.renderResponse) {
          recorder.renderResponse({
            valence: -0.2, arousal: 0.6, emotion: "transit_overload",
            responseType: "transit_grounding",
            content: "It looks like you're in transit. Activating sensory grounding.",
            distressFlag: false
          });
        }
      });


      // Toggle Analytics
      const toggleBtn = document.getElementById('toggle-analytics-btn');
      const analyticsPanel = document.getElementById('analytics-panel');
      if (toggleBtn && analyticsPanel) {
        toggleBtn.addEventListener('click', () => {
          analyticsPanel.classList.toggle('hidden');
        });
      }

      // Private Micro-Memory Continuity Greeting
      document.addEventListener('DOMContentLoaded', async () => {
        try {
          // Check for sessions in the last 6 hours
          const recentLogs = await getRecentMoodLogs(6);
          if (recentLogs && recentLogs.length > 0) {
            const heading = document.getElementById('ui-heading');
            if (heading) {
              // We only override if it's currently showing the default English text 
              // (language swapping might interfere, but this is a simple anchor)
              if (heading.textContent.includes('Tell me how you’re feeling')) {
                heading.textContent = "Welcome back. Are you still navigating that pressure, or should we set a brand-new focus today?";
                heading.classList.add('text-2xl'); // Slightly smaller for longer text
              }
            }
          }
        } catch (e) {
          console.error("Failed to load micro-memory greeting", e);
        }
      });
      
      document.getElementById('toggle-posture-btn')?.addEventListener('click', () => {
         if (window.togglePostureTracking) window.togglePostureTracking();
      });
    </script>
  </body>
</html>
