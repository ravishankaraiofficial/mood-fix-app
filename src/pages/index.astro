---
// Homepage
import '../styles/global.css';
import MoodRecorder from '../components/MoodRecorder.astro';
import AnalyticsTab from '../components/AnalyticsTab.astro';
import VoiceJournal from '../components/VoiceJournal.astro';
---
<html lang="en" style="color-scheme: light;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Mood Relief - You are not alone</title>
    <script is:inline>
      const h = new Date().getHours();
      if (h >= 21 || h < 6) {
        document.documentElement.classList.add('theme-night');
      }
    </script>
    <!-- Offline-First PWA Registration -->
    <script>
      // @ts-nocheck
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
    <style is:global>
      html.theme-night body {
        background-color: #120909 !important; /* Charcoal */
        color: #ffc4b8 !important;
      }
      html.theme-night .bg-orange-50 { background-color: #1a0f0f !important; }
      html.theme-night .bg-orange-100 { background-color: #2a1515 !important; }
      html.theme-night .text-orange-900 { color: #ffd6cc !important; }
      html.theme-night .text-orange-800 { color: #ffb8a8 !important; }
      html.theme-night .border-orange-200 { border-color: #4a2525 !important; }
      html.theme-night .bg-orange-500 { background-color: #9f1239 !important; /* Crimson */ }
      html.theme-night .bg-white { background-color: #1a0f0f !important; border-color: #3a1515 !important; }
      html.theme-night #lang-toast { background-color: #9f1239 !important; color: #fff !important; }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu&family=Noto+Sans+Bengali&family=Noto+Sans+Devanagari&family=Noto+Sans+Gujarati&family=Noto+Sans+Gurmukhi&family=Noto+Sans+Kannada&family=Noto+Sans+Malayalam&family=Noto+Sans+Oriya&family=Noto+Sans+Tamil&family=Noto+Sans+Telugu&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col items-center justify-center p-6 bg-orange-50 text-ink antialiased pb-20 transition-colors duration-1000">
    <!-- Header with Analytics Toggle -->
    <header class="w-full max-w-[375px] mx-auto flex justify-end mb-4">
      <button id="toggle-analytics-btn" class="p-2 text-orange-900/60 hover:text-orange-900 transition-colors" aria-label="Toggle Analytics">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </button>
    </header>

    <main class="w-full max-w-[375px] mx-auto flex flex-col items-center text-center">
      <MoodRecorder />
      <AnalyticsTab />
      <VoiceJournal />
    </main>

    <footer id="disclaimer-footer" class="fixed bottom-0 left-0 w-full p-4 text-center text-xs text-orange-900/60 bg-orange-50/90 backdrop-blur-sm z-50 border-t border-orange-900/10 transition-all duration-300">
      This is a calming tool, not medical advice. If you are in crisis, please reach out to someone you trust or a local helpline.
    </footer>

    <script>
      import { getRecentMoodLogs } from '../lib/db';

      // Toggle Analytics
      const toggleBtn = document.getElementById('toggle-analytics-btn');
      const analyticsPanel = document.getElementById('analytics-panel');
      if (toggleBtn && analyticsPanel) {
        toggleBtn.addEventListener('click', () => {
          analyticsPanel.classList.toggle('hidden');
        });
      }

      // Private Micro-Memory Continuity Greeting
      document.addEventListener('DOMContentLoaded', async () => {
        try {
          // Check for sessions in the last 6 hours
          const recentLogs = await getRecentMoodLogs(6);
          if (recentLogs && recentLogs.length > 0) {
            const heading = document.getElementById('ui-heading');
            if (heading) {
              // We only override if it's currently showing the default English text 
              // (language swapping might interfere, but this is a simple anchor)
              if (heading.textContent.includes('Tell me how you’re feeling')) {
                heading.textContent = "Welcome back. Are you still navigating that pressure, or should we set a brand-new focus today?";
                heading.classList.add('text-2xl'); // Slightly smaller for longer text
              }
            }
          }
        } catch (e) {
          console.error("Failed to load micro-memory greeting", e);
        }
      });
    </script>
  </body>
</html>
